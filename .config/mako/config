# Catppuccin Mocha theme for mako
# Maintainer: Catppuccin Org

font=Iosevka Nerd Font 11
width=360
height=160
margin=12
padding=12,16
border-size=2
border-radius=8
icons=1
max-icon-size=48
default-timeout=5000
group-by=summary

# Default colors (Mocha Base, Mauve border, Text)
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#cba6f7
progress-color=over #313244

[urgency=low]
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#89b4fa
default-timeout=4000

[urgency=normal]
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#cba6f7
default-timeout=5000

[urgency=high]
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#f38ba8
default-timeout=0
